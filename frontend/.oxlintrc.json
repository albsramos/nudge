{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "import"
  ],
  "ignorePatterns": [
    "src/shared/api/generated/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "typescript/no-explicit-any": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": [
              "useEffect",
              "useLayoutEffect"
            ],
            "message": "No effects: derive during render, use an event handler, a key, or a query hook. See docs/frontend.md."
          }
        ],
        "patterns": [
          {
            "group": [
              "@/shared/api/generated",
              "@/shared/api/generated/*",
              "**/shared/api/generated/**"
            ],
            "message": "Only a feature api/ folder imports generated API code."
          },
          {
            "group": [
              "@/features/*/*",
              "@/features/*/**"
            ],
            "message": "Import a feature only through its index.ts: @/features/<name>."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/features/*/api/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": [
                  "useEffect",
                  "useLayoutEffect"
                ],
                "message": "No effects: derive during render, use an event handler, a key, or a query hook. See docs/frontend.md."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/features/**"
                ],
                "message": "Features don't import other features; compose them in src/app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/components/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": [
                  "useEffect",
                  "useLayoutEffect"
                ],
                "message": "No effects: derive during render, use an event handler, a key, or a query hook. See docs/frontend.md."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/shared/api/generated",
                  "@/shared/api/generated/*",
                  "**/shared/api/generated/**"
                ],
                "message": "Only a feature api/ folder imports generated API code."
              },
              {
                "group": [
                  "@/features/**"
                ],
                "message": "Features don't import other features; compose them in src/app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/domain/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-*",
                  "@tanstack/*",
                  "@/*",
                  "../api/*",
                  "../components/*"
                ],
                "message": "The domain layer is plain TypeScript: no React, no API, no UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": [
                  "useEffect",
                  "useLayoutEffect"
                ],
                "message": "No effects: derive during render, use an event handler, a key, or a query hook. See docs/frontend.md."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/features/**",
                  "@/app/**"
                ],
                "message": "shared/ knows nothing about features or the app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/test/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": [
                  "useEffect",
                  "useLayoutEffect"
                ],
                "message": "No effects: derive during render, use an event handler, a key, or a query hook. See docs/frontend.md."
              }
            ]
          }
        ]
      }
    }
  ]
}
